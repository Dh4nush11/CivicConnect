MONGO_URI=mongodb://localhost:27017/civic-connect
JWT_SECRET=replace_with_a_long_random_secret
# Configure these Cloudinary values for persistent photo storage in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=civic-connect
# Normal login tokens have a two-hour minimum; longer values are preserved.
JWT_EXPIRES_IN=7d
PORT=5001
CLIENT_URL=http://localhost:5173
EMAIL_VERIFICATION_REQUIRED=true
SPAM_LOCATION_THRESHOLD_METERS=300
SPAM_LOCATION_ACCURACY_MULTIPLIER=2
SPAM_LOCATION_WEIGHT=0.35
SPAM_MISSING_EXIF_WEIGHT=0.03
SPAM_DUPLICATE_WEIGHT=0.45
SPAM_STALE_PHOTO_WEIGHT=0.15
SPAM_STALE_PHOTO_AGE_HOURS=24
SPAM_BEHAVIOUR_WEIGHT=0.1
SPAM_REPORTS_PER_HOUR=5
SPAM_REPORTS_PER_HOUR_WEIGHT=0.2
SPAM_NEW_ACCOUNT_AGE_HOURS=24
SPAM_NEW_ACCOUNT_BURST_COUNT=3
SPAM_SUSPECTED_THRESHOLD=35
SPAM_DUPLICATE_HASH_DISTANCE=8
SPAM_REPEATED_TEXT_MIN_LENGTH=12
SPAM_REPEATED_TEXT_REPEAT_COUNT=9
SPAM_LOW_INFORMATION_TEXT_MIN_LENGTH=20
SPAM_LOW_INFORMATION_UNIQUE_CHAR_LIMIT=3
SPAM_RESTRICTION_STRIKES=3
SPAM_RESTRICTED_DAILY_LIMIT=3
SPAM_TRUST_RESOLVED_BONUS=2
SPAM_TRUST_CLEAR_BONUS=3
SPAM_TRUST_SPAM_PENALTY=5
SPAM_TRUST_SCORE_REDUCTION=0.15
UPLOAD_TOKEN_TTL_MINUTES=15
CAPTURE_TIMESTAMP_WINDOW_MINUTES=15
IMAGE_MODERATION_PROVIDER=off
CLIP_MODEL=Xenova/clip-vit-base-patch32
CLIP_CLASSIFIER_MARGIN=0.05
NSFWJS_EXPLICIT_THRESHOLD=0.7
CLIP_CIVIC_LABELS=pothole,garbage pile,broken streetlight,waterlogging,damaged road,open drain,fallen tree
CLIP_NON_CIVIC_LABELS=selfie,meme,screenshot,indoor room,document,food
NSFWJS_MODEL_PATH=
INDORE_BOUNDARY_ENFORCEMENT=false
INDORE_BOUNDARY_GEOJSON_PATH=

# Set seed account credentials when running `npm run seed`.
ADMIN_NAME=Dhanush Pillai
ADMIN_EMAIL=dhanush11pillai@gmail.com
ADMIN_PASSWORD=replace_with_a_secure_password
SEED_CITIZEN_EMAIL=
SEED_CITIZEN_PASSWORD=
SEED_CITIZEN_NAME=Citizen
SEED_OFFICER_EMAIL=
SEED_OFFICER_PASSWORD=
SEED_OFFICER_NAME=Municipal Officer

# Prefer the Resend HTTPS API on hosts that restrict outbound SMTP.
RESEND_API_KEY=
# Set this to an address at a domain verified with Resend.
EMAIL_FROM=CivicConnect <no-reply@example.com>

# Optional SMTP fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_ETHEREAL=false
