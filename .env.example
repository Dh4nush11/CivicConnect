MONGO_URI=mongodb://localhost:27017/civic-connect
JWT_SECRET=replace_with_a_long_random_secret
# Normal login tokens have a two-hour minimum; longer values are preserved.
JWT_EXPIRES_IN=7d
PORT=5001
CLIENT_URL=http://localhost:5173
EMAIL_VERIFICATION_REQUIRED=true
SPAM_LOCATION_THRESHOLD_METERS=300
IMAGE_MODERATION_ENABLED=false
IMAGE_MODERATION_MODULE=
INDORE_BOUNDARY_ENFORCEMENT=false
INDORE_BOUNDARY_GEOJSON_PATH=

# Set seed account credentials when running `npm run seed`.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=dhanush11pillai@gmail.com
ADMIN_PASSWORD=replace_with_a_secure_password
SEED_CITIZEN_EMAIL=
SEED_CITIZEN_PASSWORD=
SEED_CITIZEN_NAME=Citizen
SEED_OFFICER_EMAIL=
SEED_OFFICER_PASSWORD=
SEED_OFFICER_NAME=Municipal Officer

# SMTP (Email) - set credentials from your email provider to deliver OTPs to inboxes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_ETHEREAL=false

# Legacy / fallback EMAIL_* vars (still supported)
EMAIL_FROM="CivicConnect <no-reply@civicconnect.local>"
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=587
